rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isSizeValid() {
      // Max 5MB for images
      return request.resource.size < 5 * 1024 * 1024;
    }
    
    // Item photos
    match /items/{itemId}/{fileName} {
      // Anyone can read item photos (public)
      allow read: if true;
      
      // Only authenticated users can upload
      // Must be an image and under 5MB
      allow create: if isSignedIn() 
        && isImage() 
        && isSizeValid();
      
      // Only item owner can delete their photos
      // (We'll need to verify ownership via Firestore in practice)
      allow delete: if isSignedIn();
    }
    
    // User profile photos
    match /users/{userId}/profile/{fileName} {
      // Anyone can read profile photos (public)
      allow read: if true;
      
      // Only the user can upload their profile photo
      allow create, update: if isOwner(userId) 
        && isImage() 
        && isSizeValid();
      
      // Only the user can delete their profile photo
      allow delete: if isOwner(userId);
    }
    
    // Damage report photos
    match /damage-reports/{loanId}/{fileName} {
      // Only loan participants can read damage photos
      allow read: if isSignedIn();
      
      // Only authenticated users can upload damage photos
      allow create: if isSignedIn() 
        && isImage() 
        && isSizeValid();
      
      // Cannot delete damage photos (evidence)
      allow delete: if false;
    }
  }
}